# Bien moi truong cho `docker compose` (compose.yaml).
#   cp .env.docker.example .env   # roi dien cac gia tri ben duoi
# File .env da nam trong .gitignore — khong commit gia tri that.

# Hostname/IP ma trinh duyet dung de mo he thong. Giu `localhost` khi chi
# dung tren may nay; dien IP LAN cua server (vd. 192.168.50.10) de may khac
# truy cap. Doi gia tri nay phai build lai frontend:
#   docker compose up -d --build
PUBLIC_HOST=localhost

# Mat khau user `postgres` cua container database. Chi dung chu cai va chu so
# vi gia tri nay duoc ghep thang vao DATABASE_URL.
POSTGRES_PASSWORD=change-me-postgres-password

# HMAC secret ky CSRF token, >= 32 ky tu. Tao bang: openssl rand -hex 32
CSRF_SECRET=change-me-to-a-random-string-at-least-32-characters

# Tai khoan ADMIN mac dinh tao boi seed (chi tao khi email chua ton tai).
# Bo trong SEED_ADMIN_PASSWORD de bo qua buoc tao admin.
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=
